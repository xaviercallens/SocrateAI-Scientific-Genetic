        (ANSE.GeneticaReticulata.ratioN (ANSE.GeneticaReticulata.diff4ae sa sb sc se) (ANSE.GeneticaReticulata.comparable4 sa sb sc se)
          + ANSE.GeneticaReticulata.ratioN (ANSE.GeneticaReticulata.diff4bc sa sb sc se) (ANSE.GeneticaReticulata.comparable4 sa sb sc se))
      < ANSE.GeneticaReticulata.ratioN (ANSE.GeneticaReticulata.diff4ab sa sb sc se) (ANSE.GeneticaReticulata.comparable4 sa sb sc se)
          + ANSE.GeneticaReticulata.ratioN (ANSE.GeneticaReticulata.diff4ce sa sb sc se) (ANSE.GeneticaReticulata.comparable4 sa sb sc se) := by
